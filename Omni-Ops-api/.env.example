# ==========================================
# CORE API CONFIG
# ==========================================
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/omni_ops?schema=public"
INTERNAL_API_KEY="generate-a-long-random-secret-here"
SECRET_ENCRYPTION_KEY="generate-another-random-secret-for-tenant-secrets"

# ==========================================
# DISCORD BOT COMMUNICATION
# ==========================================
# The internal URL the API uses to notify the bot (e.g. new leads)
BOT_NOTIFY_URL="http://localhost:3001"

# ==========================================
# WHATSAPP CLOUD API (Deployment-level)
# ==========================================
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v22.0"
WHATSAPP_MEDIA_MAX_MB=5
WHATSAPP_WELCOME_TEXT="Welcome! 👋\nThank you for contacting us. A member of our team will get back to you shortly."
WHATSAPP_EVENT_RETENTION_DAYS=60

# ==========================================
# LOCAL PHONE NUMBER DEFAULTS (Optional)
# ==========================================
# If users type "55512345" without a country code, what country are they in?
# DEFAULT_COUNTRY_CODE=974
# LOCAL_NUMBER_LENGTH=8

# ==========================================
# EMAIL (Resend)
# ==========================================
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"
PDF_LINK_SECRET="generate-a-random-secret-for-pdf-links"

# ==========================================
# GOOGLE INTEGRATIONS (Optional)
# ==========================================
# Paste the entire JSON content of your service account key here (escaped)
GOOGLE_CREDENTIALS_JSON=""
GOOGLE_CALENDAR_ID=""
GOOGLE_CALENDAR_TZ="UTC"
GOOGLE_TZ_OFFSET_HOURS=0
PERSONAL_TASKS_CALENDAR_ID=""

# Google Sheets (Optional)
GOOGLE_SHEETS_ID=""
ACCOUNTING_SHEET_ID=""
PERSONAL_TASKS_SHEET_ID=""

# ==========================================
# CHATWOOT INBOX (Optional)
# ==========================================
CHATWOOT_BASE_URL="https://app.chatwoot.com"
CHATWOOT_INBOX_IDENTIFIER=""
CHATWOOT_WEBHOOK_SECRET=""